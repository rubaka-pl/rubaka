# Public Supabase client values (safe for the browser; protected by RLS).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only needed for GitHub Pages builds: "/<repository-name>/"
VITE_BASE_PATH=/

# Third-party API secrets (TMDB, IGDB, RAWG) are NOT set here.
# They are Supabase Edge Function secrets — see README "Metadata providers".
